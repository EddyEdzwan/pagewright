{
  "name": "pagewright",
  "productName": "Pagewright",
  "version": "0.1.0",
  "description": "Local, unrestricted PDF reader/editor for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "node scripts/gen-licenses.mjs && electron-builder --mac --dir",
    "build:web": "node scripts/gen-licenses.mjs && node scripts/build-web.mjs",
    "serve:web": "npm run build:web && python3 -m http.server 8765 --directory web-dist",
    "deploy:web": "sh scripts/deploy-web.sh",
    "licenses": "node scripts/gen-licenses.mjs"
  },
  "build": {
    "appId": "local.pagewright",
    "productName": "Pagewright",
    "electronVersion": "33.2.1",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Local build"
      }
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "application/pdf"
      }
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "author": "Eddy Edzwan"
}
